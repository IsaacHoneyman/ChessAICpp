# ---- Build output ----------------------------------------------------------
build/
*.o
*.d
*.a
*.so
*.dylib
*.exe

# Binaries built outside build/ (e.g. a stray `g++ program.cpp -o chess`)
/chess
/chess-tests
/a.out

# ---- Debug / profiling artifacts -------------------------------------------
# Core dumps and sanitizer/profiler leftovers
# (anchored to the repo root so source dirs named `core` aren't ignored)
/core
/core.[0-9]*
vgcore.*
*.log
perf.data
perf.data.old
gmon.out
callgrind.out.*
massif.out.*

# gcov / lcov coverage
*.gcno
*.gcda
*.gcov
coverage/
*.info

# ---- Tooling ---------------------------------------------------------------
# clangd's index cache (compile_flags.txt and .clang-format themselves stay tracked)
.cache/
compile_commands.json

# ---- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Engine data -----------------------------------------------------------
# Opening books, tablebases and engine logs are large and/or generated
*.bin
*.rtbw
*.rtbz

# DO NOT REMOVE
api 